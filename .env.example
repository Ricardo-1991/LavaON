# Omit VITE_DATA_MODE (or use local) for the offline IndexedDB demonstration.
# Use server for shared scheduling. Only this public mode flag enters the browser bundle.
VITE_DATA_MODE=server

# Server only. Local test administrator; never use production for local development.
# Never prefix database credentials with VITE_.
DATABASE_URL=postgresql://postgres:lavaon-local-test@127.0.0.1:55432/lavaon_test

# Published runtime uses a separate, restricted role (no schema/migration permissions).
# LAVA_DATABASE_URL is server-only. Keep administrator DATABASE_URL out of deployments.
# LAVA_DATABASE_ENV=development
# VERCEL_ENV is set by Vercel and must match the database marker.
# VITE_BOT_PROTECTION=on is set by vercel.json during hosted builds.
# Local builds omit it; server-side verification remains mandatory on Vercel.

# Optional canonical browser origin; useful behind a local proxy.
APP_ORIGIN=http://localhost:5173
