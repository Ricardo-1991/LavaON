# Omit VITE_DATA_MODE (or use local) for the offline IndexedDB demonstration.
# Use server for shared scheduling. Only this public mode flag enters the browser bundle.
VITE_DATA_MODE=server

# Server only. Use DATABASE_URL from the Neon integration in Vercel Storage.
# Never prefix database credentials with VITE_.
DATABASE_URL=postgresql://postgres:lavaon-local-test@127.0.0.1:55432/lavaon_test

# Optional canonical browser origin; useful behind a local proxy.
APP_ORIGIN=http://localhost:5173
